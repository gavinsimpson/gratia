> nameEx("parametric_effects")
> ### * parametric_effects
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: parametric_effects
> ### Title: Estimated values for parametric model terms
> ### Aliases: parametric_effects parametric_effects.gamm4
> ###   parametric_effects.gam parametric_effects.scam
> 
> ### ** Examples
> 
> load_mgcv()
> 
> # Simulate numeric and factor effects
> set.seed(42)
> d <- data.frame(
+   x = runif(100),
+   group = factor(rep(c("A", "B"), each = 50))
+ )
> d$y <- with(d, 2 * x + (group == "B") + rnorm(100, sd = 0.25))
> m <- gam(y ~ x + group, data = d, method = "REML")
> 
> # Estimate and draw the contribution of each parametric term
