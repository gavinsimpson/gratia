> nameEx("appraise")
> ### * appraise
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: appraise
> ### Title: Model diagnostic plots
> ### Aliases: appraise appraise.gam appraise.lm appraise.gamlss
> ###   appraise.default appraise.gamm4 appraise.gjrm appraise.gamm
> ###   appraise.gratia_diagnostic_proxy appraise.lme appraise.merMod
> ###   appraise.sdmTMB
> 
> ### ** Examples
> 
> # Fit stopping distance as a smooth function of speed.
> mod <- mgcv::gam(dist ~ s(speed, k = 5), data = cars, method = "REML")
> # Inspect residuals, fitted values and the residual distribution.
> appraise(mod, seed = 42)
> 
> 
