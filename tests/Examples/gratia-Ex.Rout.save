> ### Aliases: model_terms model_terms.gam model_terms.gamm model_terms.gamm4
> ###   model_terms.lm model_terms.scam
> 
> ### ** Examples
> 
> load_mgcv()
> 
> # simulate data
> df <- data_sim("eg4", n = 400, dist = "normal", scale = 2, seed = 1)
> 
> # fit model
> m <- gam(y ~ fac + s(x2, by = fac) + s(x0),
+   data = df, method = "REML")
> 
> # return the names of terms in this model
> model_terms(m)
[1] "(Intercept)" "fac2"        "fac3"        "s(x2):fac1"  "s(x2):fac2" 
[6] "s(x2):fac3"  "s(x0)"      
