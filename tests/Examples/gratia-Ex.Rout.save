> nameEx("conditional_values")
> ### * conditional_values
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: conditional_values
> ### Title: Conditional predictions from a GAM
> ### Aliases: conditional_values conditional_values.gam
> ###   conditional_values.gamm4 conditional_values.scam
> 
> ### ** Examples
> 
> load_mgcv()
> # Simulate an additive Gaussian response and fit a GAM
> df <- data_sim("eg1", n = 200, seed = 2)
> m <- gam(y ~ s(x0) + s(x1) + s(x2) + s(x3), data = df, method = "REML")
> 
> # Vary x2 while holding the other covariates at representative values
