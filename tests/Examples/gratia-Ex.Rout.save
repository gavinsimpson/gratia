> # Simulate an additive Gaussian response and fit a GAM
> dat <- data_sim("eg1", n = 200, scale = 2, seed = 2)
> mod <- gam(y ~ s(x0) + s(x1) + s(x2) + s(x3), data = dat, method = "REML")
