> ### * add_sizer
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: add_sizer
> ### Title: Add indicators of significant change after SiZeR
> ### Aliases: add_sizer add_sizer.derivatives add_sizer.smooth_estimates
> 
> ### ** Examples
> 
> load_mgcv()
> ## Don't show: 
> op <- options(pillar.sigfig = 3, cli.unicode = FALSE)
> ## End(Don't show)
> df <- data_sim("eg1", n = 400, dist = "normal", scale = 2, seed = 42)
> m <- gam(y ~ s(x0) + s(x1) + s(x2) + s(x3), data = df, method = "REML")
> 
> ## first derivatives of all smooths using central finite differences
> d <- derivatives(m, type = "central") |>
+   add_sizer()
> 
> # default adds a .change column
> names(d)
 [1] ".smooth"     ".by"         ".fs"         ".derivative" ".se"        
 [6] ".crit"       ".lower_ci"   ".upper_ci"   ".change"     "x0"         
[11] "x1"          "x2"          "x3"         
> 
> 
> 
> cleanEx()

detaching ‘package:mgcv’

> nameEx("ale")
> ### * ale
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: ale
> ### Title: Accumulated local effects of a model covariate
> ### Aliases: ale ale.default ale.gam ale.bam ale.scam
> 
> ### ** Examples
> 
> load_mgcv()
> df <- data_sim("eg1", n = 200, seed = 42)
> m <- gam(y ~ s(x0) + te(x1, x2, k = c(5, 5)) + s(x3),
+   data = df, method = "REML")
> a <- ale(m, focal = "x1")
> draw(a)
> 
> # Standard deviation in its natural units, rather than reciprocal SD
> ml <- gam(list(y ~ s(x1), ~ x2), data = df, family = gaulss())
> ale(ml, "x2", parameter = "scale", scale = "response") |> draw()
> 
> 
> 
> cleanEx()

