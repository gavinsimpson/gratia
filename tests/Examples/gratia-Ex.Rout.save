> nameEx("ale")
> ### * ale
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: ale
> ### Title: Accumulated local effects of a model covariate
> ### Aliases: ale ale.default ale.gam ale.bam ale.scam
> 
> ### ** Examples
> 
> load_mgcv()
> df <- data_sim("eg1", n = 120, seed = 42)
> # Estimate the effect of x1 in a model where it interacts with x2
> m <- gam(y ~ s(x0, k = 5) + te(x1, x2, k = c(4, 4)),
+   data = df, method = "REML")
> draw(ale(m, focal = "x1", n_bins = 12))
> 
> 
> 
> cleanEx()

