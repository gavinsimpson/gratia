> nameEx("model_concurvity")
> ### * model_concurvity
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: model_concurvity
> ### Title: Concurvity of an estimated GAM
> ### Aliases: model_concurvity model_concurvity.gam concrvity
> ###   model_concurvity.gamm4 model_concurvity.scam
> 
> ### ** Examples
> 
> # Simulate predictors that are related nonlinearly
> load_mgcv()
> set.seed(8)
> n <- 100
> t <- sort(runif(n))
> x <- gw_f2(t) + rnorm(n, sd = 3)
> y <- sin(4 * pi * t) + exp(x / 20) + rnorm(n, sd = 0.3)
> df <- data.frame(t = t, x = x, y = y)
> 
> # Fit both smooths and plot their overall concurvity
> m <- gam(y ~ s(t, k = 8) + s(x, k = 8), data = df, method = "REML")
> draw(model_concurvity(m))
> 
> 
> 
> cleanEx()

